# --- app ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never NEXT_PUBLIC

# --- google sign in (read by supabase/config.toml for local auth) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- email ---
RESEND_API_KEY=
EMAIL_FROM="Martin Sawyer Reunion <hello@yourdomain.com>"

# --- jobs ---
CRON_SECRET=                        # random 32 bytes (openssl rand -base64 32), guards /api/cron/*

# --- alerts, optional: webhook and cron failures are emailed here ---
ALERT_EMAIL=

# --- storage, from phase 6 onward if R2 is used ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
NEXT_PUBLIC_R2_PUBLIC_URL=
